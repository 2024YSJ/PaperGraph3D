# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# spec-kit extension catalog cache (regenerated locally)
.specify/extensions/.cache/

# ad hoc manual verification scripts (see specs/*/quickstart.md)
scratch/

# dev-only test harness (companion plugin for manual testing; never released)
# Ignored so `git clean -fd` leaves it alone, the same reason main.js survives.
test-harness/
src/devtest/
esbuild.devtest.mjs
